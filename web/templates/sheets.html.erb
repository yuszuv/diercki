<%
  all = contents.all
  open = contents.open_cases
%>
<%== heading('Blätter',
             'Jedes Blatt ist eine eigenständige Datei und öffnet für sich. Die Liste kommt aus ' \
             '<code>atlas/INHALT.md</code> — der einen Stelle, an der sie gepflegt wird.') %>

<% if all.failure? %>
  <%== open_case(all, title: 'Die Blattliste ließ sich nicht lesen') %>
<% else %>
  <div class="kasten">
    <% all.value!.reject(&:deck?).each do |sheet| %>
      <%== render('_sheet_card', locals: { sheet: sheet }) %>
    <% end %>
  </div>

  <h2>Präsentationen und Vorlagen</h2>
  <div class="kasten schmal">
    <% all.value!.select(&:deck?).each do |sheet| %>
      <%== render('_sheet_card', locals: { sheet: sheet }) %>
    <% end %>
  </div>
<% end %>

<%# Both directions are documentation faults and both stay visible. %>
<% unless open[:without_entry].empty? %>
  <div class="fehlfall">
    <b>Ohne Zeile in atlas/INHALT.md:</b>
    <%== open[:without_entry].map { |n| %(<a href="/#{h n}">#{h n}</a>) }.join(' · ') %>
    <br><span class="fehlfall-grund">Diese Dateien liegen im Wurzelverzeichnis, stehen aber in
    keiner Tabelle. Sie verschwinden hier nicht — sie stehen als offener Fall.</span>
  </div>
<% end %>

<% unless open[:without_file].empty? %>
  <div class="fehlfall">
    <b>In atlas/INHALT.md, aber nicht vorhanden:</b>
    <%= open[:without_file].join(' · ') %>
    <br><span class="fehlfall-grund">Die Liste nennt Dateien, die es nicht gibt.</span>
  </div>
<% end %>

<% unless open[:duplicate_kennung].empty? %>
  <div class="fehlfall">
    <b>Kennung doppelt vergeben:</b>
    <%= open[:duplicate_kennung].join(' · ') %>
    <br><span class="fehlfall-grund">Eine Kennung ist eine Adresse und meint genau ein Blatt.
    Solange zwei Zeilen dieselbe tragen, ist jeder Verweis darauf mehrdeutig.</span>
  </div>
<% end %>

<% unless (ohne_nummer = register_numbers_without_file).empty? %>
  <div class="fehlfall">
    <b>Blattnummern ohne Datei:</b>
    <%= ohne_nummer.join(' · ') %>
    <br><span class="fehlfall-grund">Das Namensregister verweist auf diese Nummern des gebundenen
    Bandes, <code>atlas/INHALT.md</code> ordnet ihnen keine Datei zu. Bis dahin bleibt der
    Verweis eine bloße Zahl — geraten wird nicht.</span>
  </div>
<% end %>
