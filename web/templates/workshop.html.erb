<%
  source_registers = workshop.source_registers
  notes = workshop.notes
  catalogues = workshop.catalogues

  # A guarded document keeps its normal address; the Wächter asks for a password
  # on the way. It is still marked, because hiding it would be a different answer
  # than locking it.
  list = ->(documents) do
    documents.map do |doc|
      rule = restricted.rule_for("/#{doc.path}")
      %(<a class="dok" href="/werkstatt/#{h doc.path}">) +
        %(<span class="dok-titel">#{h doc.title}#{rule ? ' <span class="verschlossen">nicht öffentlich</span>' : ''}</span>) +
        %(<span class="dok-pfad">#{h(rule ? rule.reason : doc.path)}</span></a>)
    end.join
  end
%>
<%== heading('Werkstatt',
             'Kein Blatt, sondern das Gerüst darunter — Register, Notizen, Regeln. Alles wird aus den ' \
             'Dateien im Repo gelesen; was hier steht, ist der aktuelle Stand und keine Kopie.') %>

<h2>Quellenregister</h2>
<p class="abschnitt-text">Für jedes Blatt eine Datei. Jede Zahl, die auf einer Karte steht,
hat hier eine Zeile mit Status.</p>
<% if source_registers.failure? %>
  <%== open_case(source_registers, title: 'Das Quellenregister ließ sich nicht auflisten') %>
<% else %>
  <div class="doks"><%== list.call(source_registers.value!) %></div>
<% end %>

<h2>Recherche und Entscheidungen</h2>
<p class="abschnitt-text">Festgehaltenes aus dem Bauen — warum etwas so ist, wie es ist.</p>
<% if notes.failure? %>
  <%== open_case(notes, title: 'Die Notizen ließen sich nicht auflisten') %>
<% else %>
  <div class="doks"><%== list.call(notes.value!) %></div>
<% end %>

<h2>Kataloge, Regeln, Nachschlagen</h2>
<div class="doks"><%== list.call(catalogues[:present]) %></div>
<% unless catalogues[:absent].empty? %>
  <div class="fehlfall">
    <b>Verzeichnet, aber nicht vorhanden:</b>
    <%= catalogues[:absent].join(' · ') %>
    <br><span class="fehlfall-grund">Diese Werkstatt-Einträge zeigen auf Dateien, die es nicht
    gibt — umbenannt oder gelöscht, ohne den Verweis nachzuziehen.</span>
  </div>
<% end %>
