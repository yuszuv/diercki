<%# Das gerahmte Blatt.
    Das Blatt selbst wird nicht angefasst — es kommt unverändert aus dem
    Wurzelverzeichnis in den Rahmen. Daneben steht, was bisher an drei anderen
    Stellen lag: sein Quellenregister, seine Registereinträge, sein Ort im Band. %>
<div class="blattschau">

  <div class="blattschau-kopf">
    <h1><%= blatt.title %></h1>
    <span class="blatt-datei mono"><%= blatt.file %></span>
    <a class="knopf" href="/<%= blatt.file %>" target="_blank" rel="noopener">Blatt allein öffnen&#8202;↗</a>
  </div>
  <div class="regel"></div>
  <p class="vorspann"><%= blatt.text %></p>

  <div class="blattrahmen">
    <iframe src="/<%= blatt.file %>" title="<%= blatt.title %>" loading="lazy"></iframe>
  </div>

  <div class="beiblatt">

    <section class="beiblatt-teil">
      <h2>Ort im Band</h2>
      <% if plate.failure? %>
        <%== fehlfall(plate, titel: 'Keine Zeile im Blattschlüssel') %>
      <% elsif plate.value!.numbered? %>
        <p class="blattnummer">Blatt <span class="zahl"><%= plate.value!.nr %></span>
          <% if plate.value!.derived? %>
            <span class="status status-abgeleitet">abgeleitet</span>
          <% end %>
        </p>
        <% if plate.value!.derived? %>
          <p class="abschnitt-text">Die Blattnummer ist aus dem Inhalt der Registereinträge
          erschlossen, nicht belegt. Der Rechenweg steht in
          <a href="/werkstatt/atlas/BLAETTER.md">BLAETTER.md</a>.</p>
        <% end %>
        <% if plate.value!.note %>
          <p class="abschnitt-text"><%= plate.value!.note %></p>
        <% end %>
      <% else %>
        <p class="abschnitt-text">Kein Blatt des gebundenen Bandes<% if plate.value!.note %> —
          <%= plate.value!.note %><% end %>.</p>
      <% end %>
    </section>

    <section class="beiblatt-teil">
      <h2>Quellenregister</h2>
      <% if quellen.failure? %>
        <%== fehlfall(quellen, titel: 'Kein Quellenregister') %>
      <% else %>
        <article class="prosa prosa-schmal"><%== quellen.value! %></article>
      <% end %>
    </section>

    <section class="beiblatt-teil">
      <h2>Namen auf diesem Blatt</h2>
      <% if eintraege.empty? %>
        <p class="abschnitt-text">Das Namensregister führt zu diesem Blatt keine Einträge.</p>
      <% else %>
        <p class="abschnitt-text"><span class="zahl"><%= eintraege.size %></span> Einträge,
          <a href="/register?q=&amp;art=&amp;status=">im Register nachschlagen</a>.</p>
        <div class="tabelle-rahmen">
          <table class="register">
            <thead><tr><th>Name</th><th>Art</th><th>Feld</th><th>Wert</th><th>Status</th></tr></thead>
            <tbody>
              <% eintraege.each do |e| %>
                <%== render('_registerzeile', locals: { e: e, blattspalte: false, schluessel: {} }) %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>

    <section class="beiblatt-teil">
      <h2>Weiterlesen</h2>
      <div class="doks">
        <a class="dok" href="/blatt/Zeichenerklaerung.dc.html">
          <span class="dok-titel">Zeichenerklärung</span>
          <span class="dok-pfad">Was die Signaturen dieses Blattes bedeuten</span></a>
        <a class="dok" href="/werkstatt/atlas/GLOSSAR.md">
          <span class="dok-titel">Glossar</span>
          <span class="dok-pfad">Fachbegriffe der Blätter, alphabetisch</span></a>
      </div>
    </section>

  </div>
</div>
