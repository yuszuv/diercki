# Copy to .env and fill in. Git ignores .env; this file is the template.
#
#     cp .env.example .env
#
# .env is the name docker compose reads by itself, and the only one — .env.local
# and .env.development come from the Node and Rails worlds and are ignored here
# unless you pass --env-file. On the server the same file is written by bmeise's
# dockerapp role from `dockerapp_env`.
#
# Running without Docker, config.ru reads it: puma does not do what compose does.
# It reads values literally — no ${…} resolution — and anything already in the
# environment wins over what stands here.
#
# Without these three the application refuses to start, and compose refuses to
# bring it up. That is deliberate: a default secret is worse than none, because
# nothing looks broken while it is in place.

ATLAS_KONTO=jan

# The bcrypt hash, base64-encoded:
#
#     ruby -rbcrypt -e 'print [BCrypt::Password.create("dein-passwort")].pack("m0")'
#
# Base64 is not a preference. Compose resolves ${…} inside every value it reads,
# this file included, and a bcrypt hash is made of $-fields. Measured: raw,
# "$2a$12$KDvI…/qxuoa" reaches the container as "a2/qxuoa" and the correct
# password stops working with nothing to explain it. web/auth.rb refuses to start
# on anything that does not decode to a bcrypt hash.
ATLAS_PASSWORT_HASH=

#     ruby -rsecurerandom -e 'print SecureRandom.hex(64)'
ATLAS_SESSION_SECRET=

# Optional: which image the production service pulls. Defaults to :latest, which
# is what "deploy main" means. Pin a named state with :sha-<commit>.
# ATLAS_IMAGE=ghcr.io/yuszuv/diercki:sha-0000000
