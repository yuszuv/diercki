# Copy to .env and fill in. Git ignores .env; this file is the template.
#
#     cp .env.example .env
#
# .env is the name docker compose reads by itself, and for compose it is still
# the only one — .env.local and .env.development are ignored there unless you
# pass --env-file. On the server the same file is written by bmeise's dockerapp
# role from `dockerapp_env`.
#
# Running without Docker, puma does not do what compose does, so the application
# reads the file itself: the settings provider in web/boot.rb, through dotenv,
# and there the chain is longer. First file that sets a name wins:
#
#     .env.<RACK_ENV>.local · .env.local (never in test) · .env.<RACK_ENV> · .env
#
# Anything already in the environment wins over all of them. That is what lets
# CI, the container and a single overridden run set values without a file.
#
# Watch the dollar signs. dotenv resolves ${…} and $VAR in what it reads, the
# same way compose does — measured, a raw bcrypt hash on a line here parses to an
# empty string. Only single quotes stop it, and they do not stop compose. This is
# the whole reason the hash below travels base64.
#
# Without these three the application refuses to start, and compose refuses to
# bring it up. That is deliberate: a default secret is worse than none, because
# nothing looks broken while it is in place.

ATLAS_KONTO=jan

# The bcrypt hash, base64-encoded:
#
#     ruby -rbcrypt -e 'print [BCrypt::Password.create("dein-passwort")].pack("m0")'
#
# Base64 is not a preference, and there are two readers to protect it from. A
# bcrypt hash is made of $-fields, and both of them resolve those. Measured:
# compose turns "$2a$12$KDvI…/qxuoa" into "a2/qxuoa" on the way into the
# container, and dotenv turns the same line into an empty string here. Either way
# the correct password stops working with nothing to explain it — so web/boot.rb
# refuses to start on anything that does not decode to a bcrypt hash.
ATLAS_PASSWORT_HASH=

#     ruby -rsecurerandom -e 'print SecureRandom.hex(64)'
ATLAS_SESSION_SECRET=

# Optional: which image the production service pulls. Defaults to :latest, which
# is what "deploy main" means. Pin a named state with :sha-<commit>.
# ATLAS_IMAGE=ghcr.io/yuszuv/diercki:sha-0000000
